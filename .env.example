OLLAMA_BASE_URL=http://127.0.0.1:11434
# Legacy/default model used when no task-specific model profiles have been saved.
# Configure multiple profiles and task assignments in the local Settings UI.
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_THREAD=0
SETTINGS_DB_PATH=data/settings.db
LEARNING_DB_PATH=data/learning.db
HOST=127.0.0.1
PORT=8000

# Optional isolated sandbox/self-improvement gates; remain disabled until explicitly configured.
SANDBOX_ENABLED=0
SANDBOX_DOCKER_EXECUTABLE=
SANDBOX_PYTHON_IMAGE=
# Immutable local image ID (sha256:<64 hex>) or repository@sha256:<64 hex> with pytest and project dependencies.
SANDBOX_TEST_IMAGE=
SELF_IMPROVEMENT_REPO_ROOT=

# Optional peer-AI review: configure JSON provider metadata, never literal API secrets.
# See docs/PEER_AI_REVIEW.md for the full format and security requirements.
# PEER_AI_PROVIDERS_JSON=[]
# PROVIDER_A_API_KEY=
