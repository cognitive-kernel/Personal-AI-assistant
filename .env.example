OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_THREAD=0
# Optional per-purpose model overrides; editable settings in the local UI take precedence after first startup.
# CHAT_OLLAMA_MODEL=qwen2.5:7b
# LEARNING_OLLAMA_MODEL=qwen3:8b
# PROGRAMMING_OLLAMA_MODEL=qwen3:14b
SETTINGS_DB_PATH=data/settings.db
LEARNING_DB_PATH=data/learning.db
HOST=127.0.0.1
PORT=8000

# Optional isolated sandbox/self-improvement gates; remain disabled until explicitly configured.
SANDBOX_ENABLED=0
SANDBOX_DOCKER_EXECUTABLE=
SANDBOX_PYTHON_IMAGE=
# Immutable local image ID (sha256:<64 hex>) or repository@sha256:<64 hex> with pytest and project dependencies.
SANDBOX_TEST_IMAGE=
SELF_IMPROVEMENT_REPO_ROOT=

# Optional AI-learning capture module; both gates are off by default.
AI_LEARNING_ENABLED=0
AI_LEARNING_RETRIEVAL_ENABLED=0
AI_LEARNING_DB_PATH=data/ai_learning.db

# Optional visible-UI ChatGPT automation (install with: pip install -e ".[browser]")
# AI_LEARNING_CHROME_PATH=C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe
# AI_LEARNING_BROWSER_PROFILE=data/ai_learning_browser_profile
