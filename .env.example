OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_THREAD=0
# Optional per-purpose model overrides; editable settings in the local UI take precedence after first startup.
# CHAT_OLLAMA_MODEL=qwen2.5:7b
# LEARNING_OLLAMA_MODEL=gpt-oss:20b
# PROGRAMMING_OLLAMA_MODEL=qwen3:14b
# Optional independent semantic reviewer; must have a distinct installed model digest.
# FACTUAL_REVIEW_OLLAMA_MODEL=qwen2.5:14b
SETTINGS_DB_PATH=data/settings.db
LEARNING_DB_PATH=data/learning.db
HOST=127.0.0.1
PORT=8000

# Optional API key value for an OpenAI-compatible provider.
# In dashboard settings, set the corresponding *_llm_api_key_env field to OPENAI_API_KEY.
# Never store API keys in the settings database or commit a populated value.
# OPENAI_API_KEY=

# Sandbox and self-improvement module switches/configuration are managed in dashboard Settings.
# Execution still requires a digest-pinned Docker image and explicit persisted user consent.
# GitHub credentials are secrets and remain in the environment, never in the settings database.
SELF_IMPROVEMENT_GITHUB_TOKEN=

# AI Learning and published-knowledge retrieval are enabled by default.
# Change module and resource controls in the dashboard Settings page.
AI_LEARNING_DB_PATH=data/ai_learning.db

# Visible-UI ChatGPT automation paths and browser timing are configured in dashboard Settings.

# Optional JSON map of model prices used only for estimated usage-cost telemetry.
# LEARNING_MODEL_PRICING_JSON={}
