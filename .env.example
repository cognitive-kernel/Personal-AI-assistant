OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_THREAD=0
# Optional per-purpose model overrides; editable settings in the local UI take precedence after first startup.
# CHAT_OLLAMA_MODEL=qwen2.5:7b
# LEARNING_OLLAMA_MODEL=qwen3:8b
# PROGRAMMING_OLLAMA_MODEL=qwen3:14b
# Optional independent factual-review model; must have a different installed digest from generation models.
# FACTUAL_REVIEW_OLLAMA_MODEL=qwen2.5:14b
SETTINGS_DB_PATH=data/settings.db
LEARNING_DB_PATH=data/learning.db
HOST=127.0.0.1
PORT=8000

# Optional isolated sandbox/self-improvement gates; remain disabled until explicitly configured.
SANDBOX_ENABLED=0
SANDBOX_DOCKER_EXECUTABLE=
SANDBOX_PYTHON_IMAGE=
# Optional official Node/Rust images, each pinned by SHA-256 digest and pre-pulled locally.
SANDBOX_NODE_IMAGE=
SANDBOX_RUST_IMAGE=
# Immutable local image ID (sha256:<64 hex>) or repository@sha256:<64 hex> with pytest and project dependencies.
SANDBOX_TEST_IMAGE=
SELF_IMPROVEMENT_REPO_ROOT=
